# =============================================================================
# PluginBargains — Environment Variables
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# --- Site URL ---
# Public origin used for metadata, canonical URLs, and Discord links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/audioplugin?retryWrites=true&w=majority

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# --- Google OAuth (https://console.cloud.google.com) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Admin ---
# Comma-separated Google account emails that can access /admin
ADMIN_EMAILS=you@example.com

# --- Discord (optional — worker sends most scrape alerts) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- Local dev only (optional) ---
# SEED_MANUFACTURERS=Soundtoys,Eventide
# SEED_FAKE_PRICES=1
